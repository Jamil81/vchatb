# ── Mode ──────────────────────────────────────────────
# true  = Ollama + faster-whisper + Piper (all local, no API keys needed)
# false = Claude + Deepgram + Cartesia (production stack)
LOCAL_MODE=true

# ── STT ───────────────────────────────────────────────
WHISPER_MODEL=medium
WHISPER_DEVICE=cuda

# Production: Deepgram Nova-3
DEEPGRAM_API_KEY=

# ── LLM ───────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Production: Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── TTS ───────────────────────────────────────────────
PIPER_PATH=./piper/piper.exe
PIPER_VOICE_EN=./piper/voices/en_US-amy-medium.onnx
PIPER_VOICE_AR=./piper/voices/ar_JO-kareem-medium.onnx

# Production: Cartesia Sonic
CARTESIA_API_KEY=

# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite:///./vchatb.db
