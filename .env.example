# ── Mode ──────────────────────────────────────────────
# true  = Ollama + faster-whisper + Piper (all local, no API keys needed)
# false = Claude + Deepgram + Cartesia (production stack)
LOCAL_MODE=true

# ── STT ───────────────────────────────────────────────
# Local: which faster-whisper model to load (tiny|small|medium|large)
WHISPER_MODEL=small

# Production: Deepgram Nova-3
DEEPGRAM_API_KEY=

# ── LLM ───────────────────────────────────────────────
# Local: Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# Production: Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── TTS ───────────────────────────────────────────────
# Local: Piper — path to piper executable + model
PIPER_EXECUTABLE=piper
PIPER_MODEL=en_US-lessac-medium

# Production: Cartesia Sonic
CARTESIA_API_KEY=

# ── Database ──────────────────────────────────────────
DATABASE_URL=sqlite:///./chatbot.db
